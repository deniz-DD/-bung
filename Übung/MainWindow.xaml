<Window x:Class="Übung.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Übung"
        mc:Ignorable="d"
         Title="MainWindow"
          Width="314" Height="473"
             MinWidth="314" MinHeight="473"
             UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <Style x:Key="CalcButton" TargetType="Button">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>
    </Window.Resources>


    <Grid Margin="8">
        <!-- 2/7 für Display, 5/7 für Tasten -->
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="5*"/>
        </Grid.RowDefinitions>

        <!-- Display -->
        <Border Grid.Row="0" CornerRadius="8" BorderThickness="1"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="2*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Name="txt_up"
                           Text="{Binding HistoryText}" 
                           TextAlignment="Right" 
                           Opacity="0.65" 
                           FontSize="12"/>
                <TextBox Grid.Row="1"
                         Padding="0 0 20 0"
                         Name="txt_down"
                         Text=""
                         IsReadOnly="True"
                         BorderThickness="0"
                         Background="Transparent"
                         FontSize="28"
                         HorizontalContentAlignment="Right"
                         VerticalContentAlignment="Center" TextChanged="TextBox_TextChanged" HorizontalAlignment="Left" Width="280"/>
            </Grid>
        </Border>

        <!-- Tasten -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Zeile 0 -->
            <Button Grid.Row="0" Grid.Column="0" Content="CE" Style="{StaticResource CalcButton}"/>
            <Button Name="btnClear" Grid.Row="0" Grid.Column="1" Content="C"  Style="{StaticResource CalcButton}" Click="btnClear_Click_1"/>
            <Button Grid.Row="0" Grid.Column="2" Content="⌫"  Style="{StaticResource CalcButton}"/>
            <Button Grid.Row="0" Grid.Column="3" Content="÷"  Style="{StaticResource CalcButton}"/>

            <!-- Zeile 1 -->
            <Button Name="btn7"  Grid.Row="1" Grid.Column="0" Content="7" Style="{StaticResource CalcButton}" Click="btn7_Click_1"/>
            <Button Name="btn8" Grid.Row="1" Grid.Column="1" Content="8" Style="{StaticResource CalcButton}" Click="btn8_Click"/>
            <Button Name="btn9" Grid.Row="1" Grid.Column="2" Content="9" Style="{StaticResource CalcButton}" Click="btn9_Click"/>
            <Button Grid.Row="1" Grid.Column="3" Content="×" Style="{StaticResource CalcButton}"/>

            <!-- Zeile 2 -->
            <Button Name="btn4" Grid.Row="2" Grid.Column="0" Content="4" Style="{StaticResource CalcButton}" Click="btn4_Click"/>
            <Button Name="btn5" Grid.Row="2" Grid.Column="1" Content="5" Style="{StaticResource CalcButton}" Click="btn5_Click"/>
            <Button Name="btn6" Grid.Row="2" Grid.Column="2" Content="6" Style="{StaticResource CalcButton}" Click="btn6_Click"/>
            <Button Name="btnMinus" Grid.Row="2" Grid.Column="3" Content="−" Style="{StaticResource CalcButton}" Click="btnMinus_Click"/>

            <!-- Zeile 3 -->
            <Button Name="btn1" Grid.Row="3" Grid.Column="0" Content="1" Style="{StaticResource CalcButton}" Click="btn1_Click"/>
            <Button Name="btn2"  Grid.Row="3" Grid.Column="1" Content="2" Style="{StaticResource CalcButton}" Click="btn2_Click" HorizontalAlignment="Left" Width="75"/>
            <Button Name="btn3" Grid.Row="3" Grid.Column="2" Content="3" Style="{StaticResource CalcButton}" Click="btn3_Click"/>
            <Button Name="btnPlus"  Grid.Row="3" Grid.Column="3" Content="+" Style="{StaticResource CalcButton}" Click="btnPlus_Click"/>

            <!-- Zeile 4 -->
            <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Content="0" Style="{StaticResource CalcButton}"/>
            <Button Grid.Row="4" Grid.Column="2" Content="," Style="{StaticResource CalcButton}"/>
            <Button Name="btnPass" Grid.Row="4" Grid.Column="3" Content="=" Style="{StaticResource CalcButton}" Click="btnPass_Click"/>
        </Grid>
    </Grid>
</Window>
